@model POOI_EF_SALAZAR.Models.Consumidor

@{
    ViewBag.Title = "Crear Consumidor";
}

<h2>Registrar Consumidor</h2>

@if (ViewBag.mensaje != null)
{
    <div class="alert alert-info">
        @ViewBag.mensaje
    </div>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <h4>Consumidor</h4>
        <hr />

        <div class="form-group">
            @Html.LabelFor(model => model.Dnicont, "DNI", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Dnicont, new { htmlAttributes = new { @class = "form-control", @maxlength = "8" } })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Nomcont, "Nombre", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Nomcont, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Apecont, "Apellido", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Apecont, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Emailcont, "Email", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Emailcont, new { htmlAttributes = new { @class = "form-control", @type = "email" } })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.Idpais, "Código País", new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Idpais, new { htmlAttributes = new { @class = "form-control", @maxlength = "3" } })
            </div>
        </div>

        <br />
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Guardar" class="btn btn-success" />
            </div>
        </div>
    </div>
}

<br />
<div>
    @Html.ActionLink("Volver a la Lista", "Index")
</div>